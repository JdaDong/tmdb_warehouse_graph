# =============================================================================
# 本地环境配置模板（复制为 .env 后使用：make env-init 会自动生成随机口令）
#   本文件只含“结构 + 占位符”，真实密钥只写入 .env（已被 .gitignore 忽略）
#   修改 .env 后需重建相关服务；清库重建请用：scripts/teardown.sh --purge
# =============================================================================

# ---------- 运行环境 ----------
TMDBWH_ENV=local                 # local / dev / staging / prod
TMDBWH_BUSINESS_ZONE=UTC         # 分区日期所属时区

# ---------- TMDB 数据源 ----------
# 本地默认走 Mock（容器内 wiremock:8080），无需真实凭证。
# 要使用真实 TMDB：设置 TMDB_MOCK_MODE=false 并填入 TMDB_BEARER_TOKEN（推荐）或 TMDB_API_KEY。
TMDB_MOCK_MODE=true
TMDB_BASE_URL=http://wiremock:8080/3
TMDB_EXPORT_BASE_URL=http://wiremock:8080/p/exports
TMDB_BEARER_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
TMDB_RATE_LIMIT=20               # 官方上限约 50 req/s，本地保守设置
TMDB_MAX_CONCURRENCY=8

# ---------- 对象存储（MinIO / S3）----------
# root 凭据：仅用于初始化与控制台登录
S3_ENDPOINT=http://minio:9000    # 容器内地址；宿主机访问用 http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=tmdb-lake
CLICKHOUSE_COLD_BUCKET=tmdb-cold # ClickHouse TTL 下沉的冷存储桶
# 应用专用账号（最小权限），由 scripts/init/init-minio.sh 自动创建
S3_APP_ACCESS_KEY=CHANGE_ME
S3_APP_SECRET_KEY=CHANGE_ME
# 镜像来源（可替换为你自己的 MinIO 仓库；官方 minio/minio 社区镜像已下线）
MINIO_IMAGE=bitnamilegacy/minio:2024.5.10
MC_IMAGE=bitnamilegacy/minio-client:2024.5.9

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092   # 容器内；宿主机访问用 localhost:9095

# ---------- ClickHouse（OLAP）----------
CLICKHOUSE_URL=jdbc:clickhouse://clickhouse:8123/default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_DB=default
CLICKHOUSE_CLUSTER=tmdb_cluster
CLICKHOUSE_CLUSTER_SECRET=CHANGE_ME  # 集群内部互信密钥（分布式查询 / DDL）

# ---------- Neo4j ----------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_DATABASE=neo4j

# ---------- Iceberg / Hive Metastore ----------
HIVE_METASTORE_URI=thrift://hive-metastore:9083
ICEBERG_WAREHOUSE=s3a://tmdb-lake/warehouse
# apache/hive:3.1.3 仅提供 amd64 镜像；Apple Silicon 留空即自动使用模拟运行，
# 在 amd64 机器上可显式设为 linux/amd64
HMS_PLATFORM=

# ---------- PostgreSQL（HMS / Airflow / OpenMetadata 元数据库）----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
HMS_DB_PASSWORD=CHANGE_ME
AIRFLOW_DB_PASSWORD=CHANGE_ME
OM_DB_PASSWORD=CHANGE_ME

# ---------- Airflow ----------
# Fernet key 必须是 urlsafe base64 的 32 字节密钥：
#   python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=AIRFLOW_FERNET_KEY_PLACEHOLDER
AIRFLOW_SECRET_KEY=CHANGE_ME
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME

# ---------- OpenMetadata（可选，governance profile）----------
# 从 UI（设置 → Bots → ingestion-bot）生成后填入；为空时元数据采集会自动跳过
OM_JWT_TOKEN=

# ---------- Grafana / 其他 ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
BIND_ADDRESS=127.0.0.1           # 端口只绑定本机，避免暴露到局域网
# Maven 仓库（国内网络可改为 https://maven.aliyun.com/repository/public）
MAVEN_REPO=https://repo1.maven.org/maven2
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=4g
