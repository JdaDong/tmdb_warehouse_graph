<?xml version="1.0"?>
<!--
  集成测试专用最小存储配置：把生产环境用到的 hot_cold 策略映射到默认本地磁盘，
  这样迁移脚本中的 storage_policy = 'hot_cold' 与 TTL ... TO VOLUME 'cold' 才会在真实 ClickHouse 上通过语法校验。
-->
<clickhouse>
    <storage_configuration>
        <policies>
            <hot_cold>
                <volumes>
                    <hot>
                        <disk>default</disk>
                    </hot>
                    <cold>
                        <disk>default</disk>
                        <prefer_not_to_merge>true</prefer_not_to_merge>
                    </cold>
                </volumes>
                <move_factor>0.1</move_factor>
            </hot_cold>
        </policies>
    </storage_configuration>
</clickhouse>
