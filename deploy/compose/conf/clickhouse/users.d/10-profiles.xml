<?xml version="1.0"?>
<!--
  设置档案（Settings Profiles）：按工作负载隔离资源。
  用户与角色本身通过 SQL RBAC 创建（tmdb-governance access-policies.yml），创建时引用这里的档案：
    CREATE USER etl_writer ... SETTINGS PROFILE 'etl'
  配额（QUOTA）同样通过 SQL 声明，便于审计与版本化。
-->
<clickhouse>
    <profiles>
        <!-- 默认档案：管理员 / 平台内部连接 -->
        <default>
            <max_memory_usage>4294967296</max_memory_usage>
            <max_execution_time>600</max_execution_time>
            <load_balancing>nearest_hostname</load_balancing>
            <log_queries>1</log_queries>
            <log_query_views>1</log_query_views>
            <distributed_ddl_task_timeout>180</distributed_ddl_task_timeout>
            <!-- 写入去重窗口：同一批数据重复提交时由服务端去重（配合幂等重试） -->
            <insert_deduplicate>1</insert_deduplicate>
            <date_time_input_format>best_effort</date_time_input_format>
        </default>

        <!-- 离线 / 实时写入 -->
        <etl>
            <max_memory_usage>8589934592</max_memory_usage>
            <max_execution_time>3600</max_execution_time>
            <max_insert_threads>4</max_insert_threads>
            <max_partitions_per_insert_block>200</max_partitions_per_insert_block>
            <insert_deduplicate>1</insert_deduplicate>
            <log_queries>1</log_queries>
            <log_query_views>1</log_query_views>
            <date_time_input_format>best_effort</date_time_input_format>
        </etl>

        <!-- 分析师 / BI：只读 + 严格资源上限 -->
        <analyst>
            <readonly>2</readonly>
            <max_memory_usage>2147483648</max_memory_usage>
            <max_execution_time>60</max_execution_time>
            <max_result_rows>1000000</max_result_rows>
            <result_overflow_mode>throw</result_overflow_mode>
            <max_rows_to_read>5000000000</max_rows_to_read>
            <read_overflow_mode>throw</read_overflow_mode>
            <max_threads>8</max_threads>
            <log_queries>1</log_queries>
        </analyst>
    </profiles>
</clickhouse>
