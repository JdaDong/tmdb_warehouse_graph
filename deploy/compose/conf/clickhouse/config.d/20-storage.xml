<?xml version="1.0"?>
<!--
  冷热分层存储（数据治理 - 生命周期管理的物理基础）：
    hot  卷：本地磁盘（default），承接写入与近期高频查询
    cold 卷：MinIO 上的 S3 磁盘 + 本地文件缓存，存放 TTL 迁移后的历史分区
  使用方式：建表时 SETTINGS storage_policy = 'hot_cold'，并声明
    TTL dt + INTERVAL 90 DAY TO VOLUME 'cold'
  具体策略由 tmdb-governance 的 lifecycle-policies.yml 统一管理。
  S3 端点与凭证来自环境变量（docker-compose 注入），不在配置文件中出现明文密钥。
-->
<clickhouse>
    <storage_configuration>
        <disks>
            <s3_cold>
                <type>s3</type>
                <endpoint from_env="CLICKHOUSE_COLD_ENDPOINT"/>
                <access_key_id from_env="S3_ACCESS_KEY"/>
                <secret_access_key from_env="S3_SECRET_KEY"/>
                <region>us-east-1</region>
                <metadata_path>/var/lib/clickhouse/disks/s3_cold/</metadata_path>
                <send_metadata>false</send_metadata>
            </s3_cold>
            <s3_cold_cache>
                <type>cache</type>
                <disk>s3_cold</disk>
                <path>/var/lib/clickhouse/disks/s3_cold_cache/</path>
                <max_size>2147483648</max_size>
                <cache_on_write_operations>false</cache_on_write_operations>
            </s3_cold_cache>
        </disks>
        <policies>
            <hot_cold>
                <volumes>
                    <hot>
                        <disk>default</disk>
                    </hot>
                    <cold>
                        <disk>s3_cold_cache</disk>
                        <!-- 冷数据不再参与后台合并，避免反复读写对象存储 -->
                        <prefer_not_to_merge>true</prefer_not_to_merge>
                    </cold>
                </volumes>
                <!-- 热盘剩余空间低于 10% 时，按分区从旧到新自动下沉到冷盘 -->
                <move_factor>0.1</move_factor>
            </hot_cold>
        </policies>
    </storage_configuration>
</clickhouse>
