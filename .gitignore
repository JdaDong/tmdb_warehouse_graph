# ===== Build =====
target/
*.class
*.jar
!**/src/test/resources/**/*.jar
dependency-reduced-pom.xml

# ===== IDE =====
.idea/
*.iml
.vscode/
.metals/
.bloop/
.classpath
.project
.settings/
*.swp
